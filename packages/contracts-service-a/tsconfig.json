{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@marcos-corp/contracts-service-a",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // `scripts` is in scope on purpose: scripts/emit.ts is gate 1 for this
  // package, and a build script nothing type-checks is a gate nothing reads.
  "include": ["src", "scripts", "*.ts"],
  // *.test.ts is excluded from check-types (parity with the root tsconfig —
  // vitest executes them; tsc doesn't gate them).
  "exclude": ["node_modules", "dist", ".tmp", "**/*.test.ts"]
}
