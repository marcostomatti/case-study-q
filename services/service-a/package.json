{
  "name": "@marcos-corp/service-a",
  "version": "0.1.0",
  "description": "Provider service for cards and transactions. Serves the @marcos-corp/contracts-service-a contract over Express through ts-rest, and owns the mapping layer that keeps @marcos-corp/db out of the contract.",
  "private": true,
  "type": "module",
  "author": "Marcos Tomatti <marcostomatti.cv@gmail.com>",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@marcos-corp/contracts-service-a": "0.1.0",
    "@marcos-corp/db": "^0.1.0",
    "@sinclair/typebox": "^0.34.52",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/express": "^3.52.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "pg": "^8.23.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
